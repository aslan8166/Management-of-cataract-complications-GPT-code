# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Build
build/
dist/

# OS
.DS_Store

# Data: raw NCBI snapshots are large and reproducible from fetch.py.
# They are intentionally NOT committed (each is a dated snapshot per AGENTS.md).
# Keep the directory but ignore its contents except the .gitkeep + logs index.
data/raw/*
!data/raw/.gitkeep

# Derived analysis outputs (regenerated by `make all`)
outputs/*
!outputs/.gitkeep

# review_queue.csv is per-corpus and regenerated by extract_models; the frozen
# data/generation_index.csv IS committed (audit artifact derived from the spine).
data/review_queue.csv
